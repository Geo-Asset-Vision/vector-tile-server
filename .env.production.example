# ==============================================================================
# Production Environment Configuration Template
# Copy this file to `.env` (or `.env.production`) on your production server.
# ==============================================================================

# Node Runtime
NODE_ENV=production

# Server Settings
APP_PORT=3000
APP_BASE_URL="https://tiles.yourdomain.com/"

# PostGIS Database Connection
POSTGIS_HOST=db
POSTGIS_PORT=5432
POSTGIS_DB=vtserver
POSTGIS_USER=vtserver
POSTGIS_PASSWORD=generate_a_strong_database_password_here
# POSTGIS_SCHEMA=public # Optional: specify schema to expose
POSTGIS_MAX_POOL=30

# Valkey / KeyDB Cache Configuration (Leave VALKEY_HOST empty to disable L2 cache)
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=generate_a_strong_valkey_password_here
VALKEY_CONNECT_TIMEOUT_MS=1000
VALKEY_COMMAND_TIMEOUT_MS=500

# MVT 2-Level Vector Tile Cache (Default TTL: 60s / 1 minute)
MVT_CACHE_ENABLED=true
MVT_CACHE_L1_ENABLED=true
MVT_CACHE_L1_MAX_ITEMS=10000
MVT_CACHE_L1_MAX_SIZE_MB=256
MVT_CACHE_L1_TTL_SECONDS=60
MVT_CACHE_L2_ENABLED=true
MVT_CACHE_L2_TTL_SECONDS=60
MVT_CACHE_L2_EMPTY_TTL_SECONDS=15
MVT_CACHE_TTL_JITTER_SECONDS=10
MVT_CACHE_SINGLE_FLIGHT_ENABLED=true
MVT_CACHE_DEBUG_HEADERS=false

# Security & API Protection
# Generate secure key using: pnpm generate:api-key
API_KEY=your_generated_production_api_key_here

# Rate Limiting (Exponential backoff for unauthorized requests)
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_BASE_BLOCK_SEC=60
