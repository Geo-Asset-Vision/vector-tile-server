# ==============================================================================
# Docker & Docker Compose Infrastructure Configuration
# ==============================================================================

# Docker Platform (Set to linux/amd64 for cross-platform Apple Silicon / Windows PC consistency)
DOCKER_DEFAULT_PLATFORM=linux/amd64

# Host Port Mappings
APP_PORT=3000
POSTGIS_PORT=5434
VALKEY_PORT=6379

# PostGIS Database Container Configuration
POSTGIS_USER=vtserver
POSTGIS_PASSWORD=vtserver
POSTGIS_DB=vtserver

# Valkey Cache Container Configuration (Uncomment to enforce password protection)
# VALKEY_PASSWORD=your_secure_valkey_password
