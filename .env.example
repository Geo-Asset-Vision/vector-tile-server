APP_PORT=3000
APP_BASE_URL="http://localhost:3000/"

POSTGIS_HOST=localhost
POSTGIS_PORT=5434
POSTGIS_DB=vtserver
# POSTGIS_SCHEMA=public # OPTIONAL (if not set, all schema will be auto discovered)
POSTGIS_USER=vtserver
POSTGIS_PASSWORD=vtserver
POSTGIS_MAX_POOL=20 # OPTIONAL (DEFAULT 20)

# VALKEY / KEYDB CONFIG (OPTIONAL - FALLBACKS TO IN-MEMORY LRU CACHE IF OMITTED)
# VALKEY_HOST=localhost
# VALKEY_PORT=6379
# VALKEY_PASSWORD=
# VALKEY_URL=redis://localhost:6379

# RATE LIMIT CONFIG
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_BASE_BLOCK_SEC=60
# Map MCP + MapLibre hardening (Wave 1; default closed)
# Comma-separated allowlists used by downstream waves. Leave blank until configured.
ALLOWED_SCHEMAS=
ALLOWED_CATALOGS=
# Stable feature IDs: explicit catalog mapping first, then single-column primary key. Never ctid.
# Format: catalog_id:feature_id_column,catalog_id_2:id
STABLE_ID_COLUMNS=
# Public/same-origin base URL guidance: browser clients must use a server-side proxy.
PUBLIC_TILE_BASE_URL=http://localhost:4000
# Comma-separated browser origins allowed to read tile/catalog responses directly. Blank rejects cross-origin browser reads.
CORS_ALLOWED_ORIGINS=
