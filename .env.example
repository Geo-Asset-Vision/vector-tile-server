# ==============================================================================
# Application Configuration (Local dev via `pnpm dev` or standalone app)
# ==============================================================================

# Server
APP_PORT=3000
APP_BASE_URL="http://localhost:3000/"

# PostGIS Database Connection
POSTGIS_HOST=localhost
POSTGIS_PORT=5434
POSTGIS_DB=vtserver
POSTGIS_USER=vtserver
POSTGIS_PASSWORD=vtserver
# POSTGIS_SCHEMA=public # OPTIONAL (if not set, all schema will be auto discovered)
# POSTGIS_MAX_POOL=20   # OPTIONAL (DEFAULT 20)

# VALKEY / KEYDB CONFIG (OPTIONAL - IF OMITTED, L2 CACHE IS DISABLED AND FALLS BACK TO L1 LRU ONLY)
# VALKEY_HOST=localhost
# VALKEY_PORT=6379
# VALKEY_PASSWORD=vtserver
# VALKEY_URL=redis://localhost:6379
# VALKEY_CONNECT_TIMEOUT_MS=1000
# VALKEY_COMMAND_TIMEOUT_MS=500

# MVT 2-LEVEL VECTOR TILE CACHE CONFIG
# MVT_CACHE_ENABLED=true
# MVT_CACHE_L1_ENABLED=true
# MVT_CACHE_L1_MAX_ITEMS=10000
# MVT_CACHE_L1_MAX_SIZE_MB=256
# MVT_CACHE_L1_TTL_SECONDS=60          # Default: 1 minute (60s)
# MVT_CACHE_L2_ENABLED=true            # Set to false to disable L2 even if Valkey is configured
# MVT_CACHE_L2_TTL_SECONDS=60          # Default: 1 minute (60s)
# MVT_CACHE_L2_EMPTY_TTL_SECONDS=15    # Negative/empty tile caching TTL
# MVT_CACHE_TTL_JITTER_SECONDS=10      # Prevent cache stampede / avalanche
# MVT_CACHE_SINGLE_FLIGHT_ENABLED=true # Process-local request coalescing
# MVT_CACHE_DEBUG_HEADERS=false        # Injects X-MVT-Cache header

# RATE LIMIT CONFIG
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_BASE_BLOCK_SEC=60

# API KEY AUTHENTICATION (OPTIONAL)
# API_KEY=