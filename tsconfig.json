{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "rootDir": ".",
    "outDir": "./dist",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/controllers/*": [
        "./src/controllers/*"
      ],
      "@/libs/*": [
        "./src/libs/*"
      ],
      "@/routes/*": [
        "./src/routes/*"
      ],
      "@/schema/*": [
        "./src/schema/*"
      ],
      "@/services/*": [
        "./src/services/*"
      ],
      "@/repositories/*": [
        "./src/repositories/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}