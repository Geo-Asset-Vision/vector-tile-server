{
  "name": "vector-tile-server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "build": "tsup src/index.ts src/mcp/stdio.ts --format esm --clean",
    "start": "node dist/index.js",
    "start:mcp": "node dist/mcp/stdio.js",
    "generate:api-key": "tsx scripts/generate-api-key.ts",
    "lint": "oxlint src scripts",
    "lint:fix": "oxlint --fix src scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "check": "pnpm check-types && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@hono/standard-validator": "^0.4.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@scalar/hono-api-reference": "^0.11.13",
    "@scalar/openapi-to-markdown": "^0.5.40",
    "@valibot/to-json-schema": "^1.7.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.2",
    "hono-openapi": "^1.3.1",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.2",
    "pbf": "^5.1.2",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mapbox__vector-tile": "^2.0.0",
    "@types/node": "^26.1.1",
    "@types/pbf": "^3.0.5",
    "@types/pg": "^8.21.0",
    "oxlint": "^1.78.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}